# Get a key at https://railradar.in/developers
RAILRADAR_API_KEY=rr_live_your_key_here

# Station for the live board. TDL = Tundla Junction.
STATION_CODE=TDL

# Live board horizon: 2, 4, 6, or 8 hours ahead (plus the last 2 hours).
HOURS_AHEAD=4

# The one-direction route we track: Tundla -> Mitawali (west side).
ROUTE_FROM=TDL
ROUTE_TO=MTI

# --- MVIS (wheel-sensor driven detection) ---------------------------------
# Sensor/cabin points that confirm a train has cleared Tundla.
#   WSC = West Side Cabin Tundla (RailRadar lists 0 trains: a cabin, not a
#         passenger station, so the resolver falls back to the Tundla board)
#   MTI = Mitawali South Cabin, filed by RailRadar under the plain code MTI
MVIS_SENSOR_POINTS=WSC,MTI

# Passenger-only axle band (inclusive). Below = goods/freight,
# above = duplicate or faulty count. Both are ignored without an API call.
MVIS_AXLE_MIN=64
MVIS_AXLE_MAX=100

# Active following: refresh interval, how many trains to keep, and how long a
# train stays tracked after its last refresh.
MVIS_POLL_SECONDS=10
MVIS_TRACK_SIZE=5
MVIS_TRACK_TTL_SECONDS=900
